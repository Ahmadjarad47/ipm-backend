{
  "ConnectionStrings": {
    "Database": "",
    "Cache": ""
  },
  "Jwt": {
    "Issuer": "ipm",
    "Audience": "ipm",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "Seed": {
    "OnStartup": true,
    "Demo": false,
    "AdminUsername": "admin",
    "AdminEmail": "",
    "AdminPassword": ""
  },
  "Telegram": {
    "Enabled": false,
    "BotToken": "",
    "BotUsername": "",
    "Mode": "Polling",
    "WebhookUrl": "",
    "WebhookSecret": "",
    "AppBaseUrl": "",
    "MessagesPerSecond": 25
  },
  "RateLimiting": {
    "AuthPerMinute": 10
  },
  "ForwardedHeaders": {
    "Enabled": false
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": { "Application": "Ipm.Api" }
  },
  "AllowedHosts": "*"
}
