# Copy to .env (git ignores .env) and fill in. docker compose reads it for the ${...} values in docker-compose.yml.
# Telegram notifications (docs/modules/11-telegram-notifications.md): create a bot with @BotFather.
# Leave the token empty and the feature stays off; the rest of the system works as before.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
