root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,props,csproj,slnx}]
indent_size = 2

[*.cs]
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_sort_system_directives_first = true

# CA1716: keyword clash with other .NET languages (e.g. VB "Error"). C#-only codebase.
dotnet_diagnostic.CA1716.severity = none
# CA1000: static factories on generic types (Result<T>) are intentional.
dotnet_diagnostic.CA1000.severity = none
# CA1711: "IDomainEventHandler" is the intended name, not a .NET event delegate.
dotnet_diagnostic.CA1711.severity = none
# CA1848 is covered by [LoggerMessage] where it matters; allow plain logging calls elsewhere.
dotnet_diagnostic.CA1848.severity = suggestion

[src/Ipm.Infrastructure/Persistence/Migrations/**.cs]
# Generated by dotnet ef: never hand-edited, so style and analyzer rules don't apply.
generated_code = true
dotnet_analyzer_diagnostic.severity = none

[tests/**.cs]
# CA1707: underscores in test method names are the readable convention.
dotnet_diagnostic.CA1707.severity = none
